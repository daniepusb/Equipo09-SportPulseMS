# ==================== POLÍTICAS GENERALES ====================
RESTART_POLICY=unless-stopped
SPRING_PROFILES_ACTIVE=dev

# ==================== JWT Y SEGURIDAD ====================
# Ejemplo de clave secreta (usa algo complejo en producción)
JWT_SECRET=mi_clave_secreta_super_segura_123456789
# 1 hora en milisegundos
JWT_ACCESS_EXPIRATION=3600000
# 24 horas en milisegundos
JWT_REFRESH_EXPIRATION=86400000
# Clave para RapidAPI (puedes obtener una en rapidapi.com)
RAPIDAPI_KEY=tu_clave_de_rapidapi_aqui

# ==================== REDIS ====================
REDIS_HOST=redis-host
REDIS_PORT=6379

# ==================== RATE LIMIT ====================
RATE_LIMIT_PER_IP=60

# ==================== PUERTOS INTERNOS (ejemplos) ====================
# Puertos para comunicación entre microservicios
AUTH_INTERNAL_PORT=9001
LEAGUES_INTERNAL_PORT=9002
TEAMS_INTERNAL_PORT=9003
FIXTURES_INTERNAL_PORT=9004
STANDINGS_INTERNAL_PORT=9005
NOTIF_INTERNAL_PORT=9006
DASHBOARD_INTERNAL_PORT=9007
GATEWAY_INTERNAL_PORT=9000

# Puerto expuesto al host (ejemplo)
GATEWAY_HOST_PORT=9000

# ==================== CREDENCIALES BASE DE DATOS ====================
# Datos para conectar a Postgres (ejemplos didácticos)
DB_HOST=postgres-auth
DB_PORT=5432
DB_NAME=example_auth_db
DB_USERNAME=example_user
DB_PASSWORD=mi_clave_postgres_123

# Base de datos para Autenticación (Docker)
AUTH_DB_NAME=example_auth_db
AUTH_DB_USER=example_user
AUTH_DB_PASSWORD=mi_clave_postgres_123

# Base de datos para Notificaciones (Docker)
NOTIF_DB_NAME=example_notif_db
NOTIF_DB_USER=example_user
NOTIF_DB_PASSWORD=mi_clave_notificaciones_456

# ==================== LÍMITES DE MEMORIA ====================
REDIS_MEM_LIMIT=256M
AUTH_DB_MEM_LIMIT=512M
NOTIF_DB_MEM_LIMIT=512M
AUTH_MEM_LIMIT=512M
LEAGUES_MEM_LIMIT=512M
TEAMS_MEM_LIMIT=512M
FIXTURES_MEM_LIMIT=512M
STANDINGS_MEM_LIMIT=512M
NOTIF_MEM_LIMIT=512M
DASHBOARD_MEM_LIMIT=512M
GATEWAY_MEM_LIMIT=768M