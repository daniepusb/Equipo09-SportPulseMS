# ==================== CONFIGURACIÓN DE BASE DE DATOS ====================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/db_name
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=mi_clave_postgres_123

# ==================== CONFIGURACIÓN JWT ====================
# Secreto para firmar los tokens (mínimo 32-64 caracteres en producción)
JWT_SECRET=mi_clave_secreta_super_segura_123456789

# Tiempo de expiración (en milisegundos)
# 3600000 = 1 hora
JWT_ACCESS_EXPIRATION=3600000
# 86400000 = 24 horas
JWT_REFRESH_EXPIRATION=86400000
